{
  "schema_version": 1,
  "id": "picodet-l-416",
  "display_name": "PicoDet-L 416",
  "family": "picodet",
  "source_framework": "paddlepaddle",
  "variant": "l-416",
  "class_count": 80,
  "labels": "../../labels/coco80.txt",
  "supported_backends": ["paddle"],
  "default_backend": "paddle",
  "deployment_validated": false,
  "input": {"name": "image", "width": 416, "height": 416, "color_order": "BGR", "layout": "CHW", "dtype": "FP32", "auxiliary_inputs": ["im_shape", "scale_factor"]},
  "preprocess": {"resize": "direct", "pad_value": 0, "scale": 0.003921568627, "mean": [0.485, 0.456, 0.406], "std": [0.229, 0.224, 0.225]},
  "postprocess": {"mode": "picodet_paddle_bbox_original", "requires_nms": false, "confidence_threshold": 0.3, "iou_threshold": 0.6, "reg_max": 7, "strides": [8, 16, 32, 64]},
  "artifacts": {"paddle": {"inputs": ["image", "im_shape", "scale_factor"], "outputs": ["bbox", "bbox_num"], "files": {"model": "model.pdmodel", "params": "model.pdiparams"}}}
}

